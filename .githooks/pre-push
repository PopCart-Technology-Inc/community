#!/bin/sh
# PUBLIC REPO: check every commit (content, file names, messages) that is about to leave this machine.
# Git passes the refs being pushed on stdin; leakcheck reads them. Never bypass with --no-verify.
PY=; for c in python3 python py; do "$c" -c "import sys; sys.exit(sys.version_info < (3, 8))" >/dev/null 2>&1 && PY=$c && break; done
[ -n "$PY" ] || { echo "leakcheck: python 3.8+ not found (blocking)" >&2; exit 1; }
exec "$PY" "$(git rev-parse --show-toplevel)/tools/leakcheck/leakcheck.py" --pre-push
