{
  "name": "popcart-community",
  "version": "0.7.0",
  "private": true,
  "description": "PopCart Community: the open network for people who work.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node app/main.ts",
    "dev": "node --watch app/main.ts",
    "dev:memory": "node app/dev.ts",
    "migrate": "node app/db/migrate-cli.ts",
    "invite": "node app/modules/accounts/invite-cli.ts",
    "mail:preview": "node app/mail/preview-cli.ts",
    "places:import": "node app/modules/places/import.ts",
    "books:stamp": "node app/modules/books/stamp-cli.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
